sfx_sabers/ahsoka_red_blade
{
    notc
    nopicmip
    cull twosided
    sort additive        // <-- Add this line

    {
        map sfx_sabers/ahsoka_red_blade
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen vertex
        alphaGen vertex
    }
}

