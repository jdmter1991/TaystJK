sfx_sabers/saber_blade_tpm
{
    notc
    nopicmip
    cull twosided
    sort additive        // <-- Add this line

    {
        map sfx_sabers/saber_blade_tpm
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen vertex
        alphaGen vertex
    }
}

