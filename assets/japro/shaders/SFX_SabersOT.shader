gfx/effects/sabers/ot_red_glow
{
	nopicmip
	notc
	cull	twosided
	{
		map gfx/effects/sabers/ot_red_glow
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen vertex
	}
}

