sfx_sabers/ot_red_blade_restored
{
    notc
    nopicmip
    cull twosided
    sort additive        // <-- Add this line

    {
        map sfx_sabers/ot_red_blade_restored
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen vertex
        alphaGen vertex
    }
}

